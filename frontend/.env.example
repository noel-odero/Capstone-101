# Public configuration only. Anything prefixed VITE_ is embedded in the browser bundle at build time, so never put secrets here.

# Origin of the public ASP.NET Core API (no path, no trailing slash). Leave empty to call the same origin,
# which in development is proxied to the API by Vite (see AMR_API_PROXY_TARGET). A non-empty value makes the
# browser call that origin directly, which requires the API to allow it (the backend has no CORS policy yet).
VITE_API_BASE_URL=

# Development and preview only (read by vite.config.ts, not embedded in the bundle): where /api is proxied.
# AMR_API_PROXY_TARGET=http://127.0.0.1:5080
